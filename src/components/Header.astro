---
import { client } from "../config/client.config";
---

<header style="position:sticky;top:0;backdrop-filter: blur(10px); background: rgba(11,15,23,.6); border-bottom:1px solid rgba(148,163,184,.12); z-index:10;">
  <div class="container" style="display:flex; align-items:center; justify-content:space-between; padding:14px var(--pad);">
    <a href="/" style="display:flex; gap:12px; align-items:center;">
      <span class="pill">{client.brand.handle}</span>
      <span style="font-weight:700;">{client.brand.name}</span>
      <span class="muted" style="font-size:13px;">{client.brand.role}</span>
    </a>

    <nav style="display:flex; gap:14px; align-items:center; font-size:14px;">
      <a href="/projects" class="muted">Proyectos</a>
      <a href="#contact" class="muted">Contacto</a>
      <a class="btn" href={client.links.github} target="_blank" rel="noreferrer">GitHub</a>
    </nav>
  </div>
</header>
