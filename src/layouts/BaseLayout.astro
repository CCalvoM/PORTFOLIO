---
import "../styles/tokens.css";

type Props = {
  title: string;
  description?: string;
};

const { title, description } = Astro.props;
const desc = description ?? "Portfolio y plantilla web con Astro.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="color-scheme" content="dark" />

    <style>
      .section{ padding: 64px 0; }
      .section h2{ margin:0 0 14px; font-size: 28px; letter-spacing: -0.02em; }
      .muted{ color: var(--muted); }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
